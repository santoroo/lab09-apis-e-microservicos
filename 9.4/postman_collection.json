{
  "info": {
    "name": "Exercicio 9.4 - Flask API na Azure",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5002"
    }
  ],
  "item": [
    {
      "name": "GET /",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "GET /items",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/items"
      }
    },
    {
      "name": "GET /items/:id",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/items/1"
      }
    },
    {
      "name": "POST /items",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/items",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Novo Item\",\n  \"description\": \"Descrição do novo item\"\n}"
        }
      }
    },
    {
      "name": "PUT /items/:id",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/items/1",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Item Atualizado\",\n  \"description\": \"Descrição atualizada\"\n}"
        }
      }
    },
    {
      "name": "DELETE /items/:id",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/items/1"
      }
    }
  ]
}
